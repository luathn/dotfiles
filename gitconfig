[user]
  name = luathn
  email = luat1203@gmail.com
  signingkey = ~/.ssh/id_ed25519.pub

[url "ssh://git@github.com/"]
    insteadOf = https://github.com/

[includeIf "gitdir:~/workspace/"]
  path = .gitconfig-company

[includeIf "gitdir:~/work/"]
  path = .gitconfig-company

[core]
  editor = nvim
  excludesFile = ~/.gitignore

[cola]
  spellcheck = false

[delta]
  line-numbers = true
  side-by-side = false
  light = true

[merge]
  conflictstyle = diff3

[push]
  default = current

[gpg]
  program = gpg
  format = ssh

[commit]
	gpgsign = true

[tag]
  gpgsign = true

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

# OS-specific settings. Git ignores this file if it does not exist.
[include]
  path = ~/.gitconfig-os
