{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 8,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],

    "modules-center": [
        "sway/window"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "format-icons": {
            "default": "○",
            "focused": "●",
            "urgent": "●"
        }
    },

    "sway/mode": {
        "format": "[ {} ]",
        "max-length": 30
    },

    "sway/window": {
        "format": "{}",
        "max-length": 45,
        "rewrite": {}
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 5,
        "format": "RAM {percentage}%",
        "tooltip": true
    },

    "network": {
        "interval": 5,
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "tray": {
        "spacing": 6
    }
}
